spring.application.name=Pharmacy

# ==========================================
# DATABASE
# ==========================================
spring.datasource.url=${DB_URL:jdbc:mariadb://localhost:3306/pharmacy_db}
spring.datasource.username=${DB_USERNAME:haru}
spring.datasource.password=${DB_PASSWORD:password}
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# ==========================================
# JPA / HIBERNATE
# ==========================================
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.default_batch_fetch_size=50
spring.jpa.open-in-view=false

# ==========================================
# MIGRATIONS
# ==========================================
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# ==========================================
# SECURITY
# ==========================================
jwt.secret=${JWT_SECRET:local_dev_secret_key_must_be_changed_in_production_env}
jwt.expiration=86400000

# ==========================================
# I18N
# ==========================================
spring.messages.basename=messages
spring.messages.encoding=UTF-8
