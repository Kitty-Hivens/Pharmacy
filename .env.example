# ==========================================
#             Database Configuration
# ==========================================
# Root password for MariaDB.
DB_ROOT_PASSWORD=change_me_please

# Name of the database.
DB_DATABASE=pharmacy_db

# ==========================================
#             App Security
# ==========================================
# Secret key for signing JWT tokens. Must be at least 32 characters long.
JWT_SECRET=please_change_this_to_a_secure_random_string

# ==========================================
#             Server Settings
# ==========================================
# The port where the application will be accessible externally.
APP_PORT=80
